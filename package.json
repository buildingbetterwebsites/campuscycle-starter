{
  "name": "bw-starter-app",
  "version": "1.0.0",
  "description": "Campus Cycle: the Next.js 16 + Payload 3 course starter students copy.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "node scripts/guard.mjs dev",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "migrate": "node scripts/guard.mjs migrate",
    "migrate:create": "node scripts/guard.mjs migrate:create",
    "seed": "node scripts/guard.mjs seed",
    "generate": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types && cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "playwright test"
  },
  "dependencies": {
    "@next/env": "16.3.6",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-vercel-blob": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@tailwindcss/postcss": "4.3.3",
    "@vercel/analytics": "2.0.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "cross-env": "7.0.3",
    "graphql": "16.14.2",
    "lucide-react": "1.52.0",
    "next": "16.3.6",
    "payload": "3.90.2",
    "postcss": "8.5.28",
    "radix-ui": "1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "happy-dom": "20.14.5",
    "playwright-core": "1.63.0",
    "prettier": "3.9.9",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vitest": "4.1.11"
  }
}
