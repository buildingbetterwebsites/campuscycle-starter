# Every text file uses LF line endings, also on Windows (where Git otherwise converts them to CRLF).
# The tests, the generated files (payload-types.ts, the admin's import map) and the course's checks
# read these files line by line, and expect LF.
* text=auto eol=lf

# Images are binary: never convert them.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
